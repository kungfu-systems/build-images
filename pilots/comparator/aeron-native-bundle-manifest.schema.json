{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kungfu-systems:build-images:aeron-native-qualification-bundle:v1",
  "title": "Aeron native-host qualification evidence bundle",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "bundle_schema",
    "schema_version",
    "status",
    "evidence_class",
    "native_performance_authority",
    "containerized_user_outcome_authority",
    "fresh_install_cost_authority",
    "final_scoring_authority",
    "bundle_id",
    "generated_at",
    "build_images_git_sha",
    "plan",
    "preparation",
    "host_facts",
    "contracts",
    "expected_results",
    "completed_results",
    "results",
    "artifacts",
    "claim_boundary"
  ],
  "properties": {
    "bundle_schema": { "const": "urn:kungfu-systems:build-images:aeron-native-qualification-bundle:v1" },
    "schema_version": { "const": 1 },
    "status": { "enum": ["complete", "incomplete"] },
    "evidence_class": { "const": "native-host-performance-qualification" },
    "native_performance_authority": { "type": "boolean" },
    "containerized_user_outcome_authority": { "const": false },
    "fresh_install_cost_authority": { "const": false },
    "final_scoring_authority": { "const": false },
    "bundle_id": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "format": "date-time" },
    "build_images_git_sha": { "pattern": "^[0-9a-f]{40}$" },
    "plan": { "type": "object" },
    "preparation": { "type": "object" },
    "host_facts": { "type": "object" },
    "contracts": { "type": "array", "minItems": 3 },
    "expected_results": { "type": "integer", "minimum": 1 },
    "completed_results": { "type": "integer", "minimum": 0 },
    "results": { "type": "array" },
    "artifacts": { "type": "array" },
    "claim_boundary": { "type": "string", "minLength": 1 }
  }
}
