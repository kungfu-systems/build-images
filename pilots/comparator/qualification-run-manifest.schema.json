{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:kungfu-systems:build-images:comparator-qualification-run:v1",
  "title": "Comparator qualification repetition manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_schema",
    "schema_version",
    "status",
    "evidence_class",
    "qualification_candidate",
    "native_performance_authority",
    "user_outcome_qualification_authority",
    "fresh_install_cost_authority",
    "final_scoring_authority",
    "bundle_id",
    "run_id",
    "repetition",
    "profile",
    "configuration_slot",
    "started_at",
    "finished_at",
    "duration_seconds",
    "inputs",
    "runtime",
    "steps",
    "retention",
    "artifacts",
    "claim_boundary"
  ],
  "properties": {
    "run_schema": { "const": "urn:kungfu-systems:build-images:comparator-qualification-run:v1" },
    "schema_version": { "const": 1 },
    "status": { "enum": ["passed", "failed"] },
    "evidence_class": { "const": "containerized-user-outcome-qualification" },
    "qualification_candidate": { "type": "boolean" },
    "native_performance_authority": { "const": false },
    "user_outcome_qualification_authority": { "const": false },
    "fresh_install_cost_authority": { "const": false },
    "final_scoring_authority": { "const": false },
    "bundle_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "repetition": { "type": "integer", "minimum": 1 },
    "profile": { "enum": ["aeron", "clickhouse", "postgres", "kungfu"] },
    "configuration_slot": { "enum": ["realistic-default", "expert-tuned"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "duration_seconds": { "type": "number", "minimum": 0 },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "build_images_git_sha",
        "plan_sha256",
        "charter",
        "fixture_set",
        "compose_sha256",
        "environment_lock_sha256",
        "runner_image",
        "pilot_script_sha256",
        "qualification_runner_sha256",
        "subject",
        "subject_sha256",
        "workload_adapter"
      ],
      "properties": {
        "build_images_git_sha": { "pattern": "^[0-9a-f]{40}$" },
        "plan_sha256": { "pattern": "^[0-9a-f]{64}$" },
        "charter": { "type": "object" },
        "fixture_set": { "type": "object" },
        "compose_sha256": { "pattern": "^[0-9a-f]{64}$" },
        "environment_lock_sha256": { "pattern": "^[0-9a-f]{64}$" },
        "runner_image": { "pattern": "@sha256:[0-9a-f]{64}$" },
        "pilot_script_sha256": { "pattern": "^[0-9a-f]{64}$" },
        "qualification_runner_sha256": { "pattern": "^[0-9a-f]{64}$" },
        "subject": { "type": "object" },
        "subject_sha256": { "pattern": "^[0-9a-f]{64}$" },
        "workload_adapter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["registry_sha256", "identity"],
          "properties": {
            "registry_sha256": { "pattern": "^[0-9a-f]{64}$" },
            "identity": { "type": "object" }
          }
        }
      }
    },
    "runtime": { "type": "object" },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "scenario_id", "job_id", "tier", "step_id", "action", "adapter",
          "project", "started_at", "finished_at", "duration_seconds",
          "timeout_seconds", "timed_out", "exit_code", "cleanup_exit_code",
          "oracles", "passed"
        ],
        "properties": {
          "scenario_id": { "type": "string", "minLength": 1 },
          "job_id": { "type": "string", "minLength": 1 },
          "tier": { "type": "string", "minLength": 1 },
          "step_id": { "type": "string", "minLength": 1 },
          "action": { "const": "workload-adapter" },
          "adapter": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id", "version", "entrypoint", "artifact", "artifact_sha256",
              "semantics", "fixture", "oracle", "registry_sha256", "binding_sha256", "receipt_path"
            ],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "version": { "type": "string", "minLength": 1 },
              "entrypoint": { "type": "string", "minLength": 1 },
              "artifact": { "type": "string", "minLength": 1 },
              "artifact_sha256": { "pattern": "^[0-9a-f]{64}$" },
              "semantics": { "type": "object" },
              "fixture": { "type": "object" },
              "oracle": { "type": "object" },
              "registry_sha256": { "pattern": "^[0-9a-f]{64}$" },
              "binding_sha256": { "pattern": "^[0-9a-f]{64}$" },
              "receipt_path": { "const": "adapter-receipt.json" }
            }
          },
          "project": { "type": "string", "minLength": 1 },
          "started_at": { "type": "string", "format": "date-time" },
          "finished_at": { "type": "string", "format": "date-time" },
          "duration_seconds": { "type": "number", "minimum": 0 },
          "timeout_seconds": { "type": "integer", "minimum": 30 },
          "timed_out": { "type": "boolean" },
          "exit_code": { "type": "integer" },
          "cleanup_exit_code": { "type": "integer" },
          "oracles": { "type": "array", "minItems": 2 },
          "passed": { "type": "boolean" }
        }
      }
    },
    "retention": { "type": "array", "minItems": 1 },
    "artifacts": { "type": "array", "minItems": 1 },
    "claim_boundary": { "type": "string", "minLength": 1 }
  }
}
