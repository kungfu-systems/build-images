{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kungfu.tech/schemas/build-images/demo-projection-v1.schema.json",
  "title": "Auditable demo public projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "evidenceClass", "claimBoundary", "cues"],
  "properties": {
    "schema": { "const": "build-images.demo-projection/v1" },
    "evidenceClass": { "type": "string", "minLength": 1, "maxLength": 120 },
    "claimBoundary": { "type": "string", "minLength": 1, "maxLength": 500 },
    "cues": {
      "type": "array",
      "minItems": 1,
      "maxItems": 240,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["startMs", "endMs", "transcriptLines"],
        "properties": {
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 1 },
          "transcriptLines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 80,
            "items": { "type": "integer", "minimum": 1 },
            "uniqueItems": true
          },
          "annotation": { "type": "string", "maxLength": 200 }
        }
      }
    }
  }
}
